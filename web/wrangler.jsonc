{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wanderer-trips",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "wanderer.yoinklabs.dev", "custom_domain": true }
  ]
}
