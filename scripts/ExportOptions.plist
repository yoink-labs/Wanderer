<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used by scripts/testflight.sh: sign for the App Store and upload the
	     build straight to App Store Connect (TestFlight). -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>64PUT29XZ8</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- The script sets CURRENT_PROJECT_VERSION itself; don't let Xcode
	     rewrite the build number during upload. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
	<key>testFlightInternalTestingOnly</key>
	<false/>
</dict>
</plist>
