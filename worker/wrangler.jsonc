{
  "name": "wanderer-api",
  "main": "src/index.ts",
    "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "CLERK_ISSUER": "https://clerk.yoinklabs.dev",
    "CLERK_JWKS_URL": "https://clerk.yoinklabs.dev/.well-known/jwks.json",
    "CLERK_AUTHORIZED_PARTIES": "",
    "RESEND_FROM_EMAIL": "",
    "APP_SHARE_BASE_URL": "https://yoinklabs.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wanderer",
      "database_id": "d3bda4a5-ce71-4ee2-92d8-f98d1e307351",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "wanderer-media" }
  ],
  "kv_namespaces": []
}
