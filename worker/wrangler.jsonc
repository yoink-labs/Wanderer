{
  "name": "wanderer-api",
  "account_id": "2bc9c3c136a62ea9dcbddaa6f59edca4",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "CLERK_ISSUER": "https://clerk.yoinklabs.dev",
    "CLERK_JWKS_URL": "https://clerk.yoinklabs.dev/.well-known/jwks.json",
    "CLERK_AUTHORIZED_PARTIES": "https://yoinklabs.dev,https://www.yoinklabs.dev,https://wanderer.yoinklabs.dev,https://wanderer-trips.yoinklabs.workers.dev,com.wanderer.ios",
    "APP_SHARE_BASE_URL": "https://api.yoinklabs.dev",
    "WEB_ORIGINS": "https://wanderer.yoinklabs.dev,https://wanderer-trips.yoinklabs.workers.dev,https://wanderer-trips.pages.dev,http://localhost:5173,http://127.0.0.1:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wanderer",
      "database_id": "4c188d7a-41d6-40aa-8169-c3dba07482c0",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "wanderer-media" }
  ],
  "kv_namespaces": [],
  "routes": [
    { "pattern": "api.yoinklabs.dev", "custom_domain": true }
  ]
}
